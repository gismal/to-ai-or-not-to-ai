{
  "manifest_version": 3,
  "name": "To AI or Not to AI",
  "version": "1.3.0",
  "description": "Right-click any image to learn whether a human or a machine made it. It admits when it is unsure.",
  "homepage_url": "https://to-ai-or-not-to-ai.onrender.com",
  "minimum_chrome_version": "102",
  "permissions": [
    "contextMenus",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://to-ai-or-not-to-ai.onrender.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "To AI or Not to AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}