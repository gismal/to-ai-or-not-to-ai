# ── Security ────────────────────────────────────────────────────────────
# Real key: admin routes and unlimited use. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me

# Public key shipped in frontend/index.html and extension/config.js. It may call
# /predict, /explain and /feedback (rate limited) but never the admin routes.
# Must match DEMO_KEY in both files. Leave empty to switch demo access off.
DEMO_API_KEY=demo-public
# Requests per minute per IP for the demo key
DEMO_RATE_LIMIT_PER_MIN=30

DEBUG=false
# CORS origins (JSON list). The playground is same-origin and the extension bypasses CORS
# through its host permissions, so production can list just your own URL, e.g. ["https://your-app.onrender.com"]
ALLOWED_ORIGINS=["*"]

# ── Model thresholds ────────────────────────────────────────────────────
# The API returns P(AI). At or above MODEL_THRESHOLD the verdict is AI_GENERATED; at or below
# (MODEL_THRESHOLD - GRAY_AREA_MARGIN) it is REAL; in between it is one of the three UNCERTAIN labels.
MODEL_THRESHOLD=0.75
GRAY_AREA_MARGIN=0.35
# Error rate (from user feedback) above which drift detection queues a retrain
DRIFT_THRESHOLD=0.15
# Minimum rated answers in the window before drift can trigger anything (stops one click starting a retrain)
DRIFT_MIN_SAMPLES=30

# ── Infrastructure ──────────────────────────────────────────────────────
# The scheme must be postgresql+asyncpg://. Hosted databases that require TLS need ?ssl=require
# (asyncpg does not understand sslmode=).
DATABASE_URL=postgresql+asyncpg://your_user:your_password@db:5432/your_db_name
# "none" runs without Redis: no cache and no retraining queue. Hosted Redis with TLS uses rediss://
REDIS_URL=redis://redis:6379/0

# Used by docker-compose only
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_db_name
GRAFANA_PASSWORD=your_grafana_password

# ── Optional ────────────────────────────────────────────────────────────
# MAX_BATCH_SIZE=10
# MLFLOW_TRACKING_URI=http://mlflow:5000
