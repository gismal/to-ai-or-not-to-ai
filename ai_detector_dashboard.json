{
    "uid": "ai-detector-mlops",
    "title": "AI Detector — MLOps Dashboard",
    "description": "Real-time observability for the AI/Not image detector API",
    "timezone": "browser",
    "refresh": "30s",
    "schemaVersion": 38,
    "time": {
        "from": "now-1h",
        "to": "now"
    },
    "templating": {
        "list": []
    },
    "tags": [
        "mlops",
        "ai-detector"
    ],
    "panels": [
        {
            "id": 1,
            "type": "stat",
            "title": "Total Requests",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 0,
                "y": 0
            },
            "options": {
                "colorMode": "background",
                "graphMode": "area",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus"
                    },
                    "expr": "sum(increase(http_requests_total[1h]))",
                    "legendFormat": "Requests (1h)"
                }
            ]
        },
        {
            "id": 2,
            "type": "stat",
            "title": "Error Rate",
            "description": "Percentage of 4xx + 5xx responses in the last hour",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 6,
                "y": 0
            },
            "options": {
                "colorMode": "background",
                "graphMode": "none",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                },
                "unit": "percent"
            },
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 2
                            },
                            {
                                "color": "red",
                                "value": 5
                            }
                        ]
                    }
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus"
                    },
                    "expr": "100 * sum(increase(http_requests_total{status_code=~\"4..|5..\"}[1h])) / sum(increase(http_requests_total[1h]))",
                    "legendFormat": "Error %"
                }
            ]
        },
        {
            "id": 3,
            "type": "stat",
            "title": "Avg Inference Latency",
            "description": "Mean ONNX inference duration (excludes cache hits)",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 12,
                "y": 0
            },
            "options": {
                "colorMode": "background",
                "graphMode": "area",
                "reduceOptions": {
                    "calcs": [
                        "mean"
                    ]
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "ms",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 300
                            },
                            {
                                "color": "red",
                                "value": 800
                            }
                        ]
                    }
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus"
                    },
                    "expr": "1000 * rate(ai_detector_inference_duration_seconds_sum[5m]) / rate(ai_detector_inference_duration_seconds_count[5m])",
                    "legendFormat": "Avg (ms)"
                }
            ]
        },
        {
            "id": 4,
            "type": "stat",
            "title": "Cache Hit Rate",
            "description": "Percentage of requests served from pHash cache",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 18,
                "y": 0
            },
            "options": {
                "colorMode": "background",
                "graphMode": "none",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                },
                "unit": "percent"
            },
            "fieldConfig": {
                "defaults": {
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 10
                            },
                            {
                                "color": "green",
                                "value": 30
                            }
                        ]
                    }
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus"
                    },
                    "expr": "100 * sum(rate(ai_detector_cache_total{result=\"hit\"}[5m])) / sum(rate(ai_detector_cache_total[5m]))",
                    "legendFormat": "Hit %"
                }
            ]
        },
        {
            "id": 5,
            "type": "timeseries",
            "title": "Request Rate by Endpoint",
            "description": "HTTP requests per second, broken down by handler",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 4
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "custom": {
                        "lineWidth": 2
                    }
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus"
                    },
                    "expr": "sum by (handler) (rate(http_requests_total{handler=~\"/v1.*\"}[2m]))",
                    "legendFormat": "{{handler}}"
                }
            ]
        },
        {
            "id": 6,
            "type": "timeseries",
            "title": "Response Time Percentiles",
            "description": "p50, p95, p99 latency across all API endpoints",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 4
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "custom": {
                        "lineWidth": 2
                    }
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus"
                    },
                    "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
                    "legendFormat": "p50"
                },
                {
                    "datasource": {
                        "type": "prometheus"
                    },
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
                    "legendFormat": "p95"
                },
                {
                    "datasource": {
                        "type": "prometheus"
                    },
                    "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
                    "legendFormat": "p99"
                }
            ]
        },
        {
            "id": 7,
            "type": "piechart",
            "title": "Prediction Distribution",
            "description": "Breakdown of prediction labels over the selected time range",
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 0,
                "y": 12
            },
            "options": {
                "pieType": "donut",
                "legend": {
                    "displayMode": "table",
                    "placement": "right",
                    "values": [
                        "percent",
                        "value"
                    ]
                }
            },
            "fieldConfig": {
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "AI Generated"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "#6C63FF",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Real"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "#22D3A5",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Uncertain"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "#FF9F43",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    }
                ]
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus"
                    },
                    "expr": "sum by (label) (increase(ai_detector_predictions_total[1h]))",
                    "legendFormat": "{{label}}"
                }
            ]
        },
        {
            "id": 8,
            "type": "timeseries",
            "title": "Prediction Labels Over Time",
            "description": "Trend of each prediction label — watch for distribution shifts (model drift signal)",
            "gridPos": {
                "h": 8,
                "w": 16,
                "x": 8,
                "y": 12
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            },
            "fieldConfig": {
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "AI_GENERATED"
                        },
                        "properties": [
                            {
                                "id": "custom.lineWidth",
                                "value": 2
                            },
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "#6C63FF",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "REAL"
                        },
                        "properties": [
                            {
                                "id": "custom.lineWidth",
                                "value": 2
                            },
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "#22D3A5",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "UNCERTAIN_NEUTRAL"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "#FF9F43",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "UNCERTAIN_LEANING_AI"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "#A89CFF",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "UNCERTAIN_LEANING_REAL"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "#7EECD3",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    }
                ]
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus"
                    },
                    "expr": "sum by (label) (rate(ai_detector_predictions_total[5m]))",
                    "legendFormat": "{{label}}"
                }
            ]
        },
        {
            "id": 9,
            "type": "timeseries",
            "title": "Error Rate Over Time",
            "description": "4xx and 5xx errors — spikes indicate client errors or model failures",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 20
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps"
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "5xx Server Errors"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "#FF6B6B",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "4xx Client Errors"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "fixedColor": "#FF9F43",
                                    "mode": "fixed"
                                }
                            }
                        ]
                    }
                ]
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus"
                    },
                    "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[5m]))",
                    "legendFormat": "5xx Server Errors"
                },
                {
                    "datasource": {
                        "type": "prometheus"
                    },
                    "expr": "sum(rate(http_requests_total{status_code=~\"4..\"}[5m]))",
                    "legendFormat": "4xx Client Errors"
                }
            ]
        },
        {
            "id": 10,
            "type": "timeseries",
            "title": "ONNX vs GradCAM Inference Duration",
            "description": "Side-by-side latency comparison — GradCAM should be consistently slower",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 20
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus"
                    },
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(ai_detector_inference_duration_seconds_bucket[5m])))",
                    "legendFormat": "ONNX p95"
                },
                {
                    "datasource": {
                        "type": "prometheus"
                    },
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(ai_detector_explain_duration_seconds_bucket[5m])))",
                    "legendFormat": "GradCAM p95"
                }
            ]
        }
    ]
}